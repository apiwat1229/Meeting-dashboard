# Copy to .env.production on the Docker host and replace every example value.
APP_PORT=3000
POSTGRES_DB=it_dashboard
POSTGRES_USER=it_dashboard
POSTGRES_PASSWORD=REPLACE_WITH_A_64_CHARACTER_HEX_PASSWORD
DATABASE_URL=postgresql://it_dashboard:REPLACE_WITH_A_64_CHARACTER_HEX_PASSWORD@db:5432/it_dashboard
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD
DASHBOARD_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DASHBOARD_COOKIE_SECURE=true
